{
  "name": "@quorumloop/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "public REST v1 and SSE boundary, authorization enforcement, aggregation",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "@quorumloop/config": "workspace:*",
    "@quorumloop/contracts": "workspace:*",
    "@quorumloop/observability": "workspace:*",
    "@quorumloop/platform": "workspace:*",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@nestjs/cqrs": "12.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
