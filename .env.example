# Quorumloop environment template. Copy to .env and replace every placeholder.
# Never commit a filled .env. Generate fresh secrets with `pnpm setup`.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Public origin of the dashboard (used for cookie origin checks and CSRF).
APP_ORIGIN=http://localhost:5173
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Bind address for gateway and web. Keep localhost until a reverse proxy is configured.
PUBLIC_BIND=127.0.0.1
# Host port the gateway is published on by infrastructure/compose/compose.core.yml.
PUBLIC_PORT=8080

# --- Infrastructure ----------------------------------------------------------
POSTGRES_HOST=127.0.0.1
# This is also the host port the core Compose file publishes postgres on, so `pnpm dev:core`
# reaches either the bundled container or a local server.
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=quorumloop
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# Password for the per-service database roles created by infrastructure/postgres/init.
POSTGRES_SERVICE_PASSWORD=change-me-service-password
# Host ports published by the core Compose file. Keep them in sync with REDIS_URL and NATS_URL.
REDIS_PORT=6379
NATS_PORT=4222
# Keep REDIS_PASSWORD and the password inside REDIS_URL identical.
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222

# --- Secrets (generate with `pnpm setup`, never reuse the examples) ----------
# HMAC key for signed internal service calls.
INTERNAL_SHARED_SECRET=change-me-internal-shared-secret-32-chars
# Session cookie signing key.
SESSION_SECRET=change-me-session-secret-at-least-32-characters
# AES-256-GCM key for forge tokens at rest, base64 encoded 32 bytes.
SECRET_ENCRYPTION_KEY=change-me-base64-32-byte-key
# One-time bootstrap token for POST /api/v1/setup/admin.
SETUP_BOOTSTRAP_TOKEN=change-me-bootstrap-token

# --- GitHub ------------------------------------------------------------------
# GitHub App is the preferred integration. Create one at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# --- GitLab ------------------------------------------------------------------
# Personal access token with `api` scope is the supported fallback until OAuth is configured.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=
# Comma separated allowlist of self-managed GitLab hosts, empty means gitlab.com only.
GITLAB_ALLOWED_HOSTS=

# --- Agent runtimes ----------------------------------------------------------
PASEO_DAEMON_URL=
PASEO_TOKEN=
ORCA_ENABLED=false
# When true, execution-service probes installed CLIs and reports readiness.
ENABLE_CLI_PROBING=true
# Allow the execution service to spend provider quota. Default off for new installs.
EXECUTION_ENABLED=false
# Hard limits enforced by the execution service.
MAX_ACTIVE_AGENTS_GLOBAL=4
MAX_ACTIVE_AGENTS_PER_PROJECT=2
MAX_RETRIES_PER_ENGINE=2
# Absolute path allowlist root for git worktrees. Must be writable by the runner.
WORKSPACE_ROOT=.quorumloop/worktrees

# --- Discovery ---------------------------------------------------------------
# `local` calls loopback ports; `dns` resolves <service-name> inside Compose or Kubernetes.
SERVICE_DISCOVERY=local
# Comma separated services this deployment runs, or `all`. The gateway reports any other service as
# not deployed instead of resolving its name. The Compose files set it; leave it unset elsewhere.
# QUORUMLOOP_DEPLOYED_SERVICES=all

# --- Features ----------------------------------------------------------------
DEMO_MODE=false
AUTO_MIGRATE=true
QUALITY_GATE_REQUIRED=true
AUDIT_RETENTION_DAYS=365

# --- Smoke test --------------------------------------------------------------
# `pnpm smoke` logs in with these. `pnpm setup` generates the password, so a second run can log in
# instead of failing after the first-run setup has already created an account.
SMOKE_EMAIL=smoke@quorumloop.local
SMOKE_PASSWORD=change-me
