{
  "name": "@quorumloop/site",
  "version": "0.1.0",
  "private": true,
  "description": "Quorumloop project page: a static site about the open-source project, not part of the dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src e2e --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
