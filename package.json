{
  "name": "quorumloop",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hosted AI development orchestration platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contracts": "turbo run test:contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @quorumloop/web dev",
    "dev:site": "pnpm --filter @quorumloop/site dev",
    "dev:services": "turbo run dev --filter=\"./services/*\" --parallel",
    "dev:core": "node scripts/dev-core.mjs",
    "dev:full": "node scripts/dev-core.mjs --full",
    "infra:up": "docker compose --env-file .env -f infrastructure/compose/compose.core.yml up -d --wait postgres redis nats",
    "infra:down": "docker compose --env-file .env -f infrastructure/compose/compose.core.yml down",
    "compose:core": "docker compose --env-file .env -f infrastructure/compose/compose.core.yml --profile core up --build",
    "compose:full": "docker compose --env-file .env --env-file infrastructure/compose/full.env -f infrastructure/compose/compose.full.yml --profile full up --build",
    "compose:demo": "docker compose --env-file .env --env-file infrastructure/compose/full.env -f infrastructure/compose/compose.full.yml --profile demo up --build",
    "db:migrate": "node scripts/migrate-all.mjs",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "github:setup": "node scripts/github-setup.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
